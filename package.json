{
  "name": "md-to-pdf",
  "version": "1.0.0",
  "description": "Professional Markdown to PDF converter with live preview, customizable print templates, resume presets, and CLI export",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cli": "node bin/cli.mjs",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "keywords": [
    "markdown",
    "pdf",
    "resume-builder",
    "converter",
    "print-css",
    "pdf-generator"
  ],
  "author": "Nikhil Grover",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "marked": "^15.0.7",
    "marked-highlight": "^2.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer": "^24.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
